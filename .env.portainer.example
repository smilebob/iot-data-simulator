# ========================================================
# IoT Data Simulator - Configuration Déploiement Portainer
# ========================================================
# Copiez ce fichier vers .env.portainer pour configurer votre
# déploiement automatisé sur votre réseau local privé.
# ATTENTION : Ne commitez JAMAIS votre clé d'API (.env.portainer est dans le .gitignore).

# --------------------------------------------------------
# Option 1 : Déploiement par Webhook Local (Recommandé & Ultra-simple)
# --------------------------------------------------------
# L'URL générée par Portainer dans la configuration de votre Stack (Automatic updates > Webhook)
# Exemple pour un Portainer local ou sur NAS/serveur de votre réseau :
PORTAINER_WEBHOOK_URL=http://<PORTAINER_HOST>:9000/api/stacks/webhooks/<WEBHOOK_UUID>

# --------------------------------------------------------
# Option 2 : Déploiement via l'API REST Portainer
# --------------------------------------------------------
# À utiliser si vous souhaitez piloter la stack via l'API Portainer :
# - URL de votre serveur Portainer (avec port 9000 pour HTTP ou 9443 pour HTTPS)
PORTAINER_URL=http://<PORTAINER_HOST>:9000

# - Clé d'accès API Portainer (Générée dans Portainer : Mon Compte / profil utilisateur > Access Tokens)
PORTAINER_API_KEY=ptr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# - Nom de la stack dans Portainer (défaut : iot-simulator)
PORTAINER_STACK_NAME=iot-simulator

# - ID de l'environnement Docker (Optionnel, 1 par défaut pour l'environnement 'local')
PORTAINER_ENDPOINT_ID=1
