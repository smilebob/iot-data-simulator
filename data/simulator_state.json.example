{
  "broker": {
    "host": "mosquitto",
    "port": 1883,
    "use_tls": false,
    "ca_cert_path": null,
    "username": null,
    "password": null,
    "transport": "tcp",
    "ws_path": "/mqtt",
    "client_id_prefix": "iot_sim_",
    "keepalive": 60
  },
  "devices": [
    {
      "id": "tb_station_01",
      "name": "Station Météo Solaire",
      "platform": "thingsboard",
      "token": "DEMO_TOKEN_WEATHER",
      "protocol": "mqtt",
      "custom_host": null,
      "custom_port": null,
      "use_tls": false,
      "publish_interval": 3.0,
      "enabled": true
    }
  ],
  "variables": [
    {
      "id": "temperature",
      "name": "Température Ambiante",
      "device_id": "tb_station_01",
      "var_type": "telemetry",
      "data_type": "float",
      "unit": "°C",
      "topic": "v1/devices/me/telemetry",
      "publish_interval": 3.0,
      "sim_mode": "sine",
      "math_config": {
        "min_val": 18.0,
        "max_val": 29.0,
        "period": 45.0,
        "offset": 0.0,
        "noise_percent": 2.5,
        "step": 1.0,
        "constant_val": "0"
      },
      "points_config": {
        "points": [],
        "loop": true,
        "playback_speed": 1.0,
        "interpolate": true
      },
      "derived_config": {
        "formula": ""
      },
      "integrator_config": {
        "source_variable_id": "",
        "time_unit": "hour",
        "multiplier": 1.0,
        "initial_value": 0.0
      },
      "enabled": true,
      "manual_override": false,
      "manual_value": null,
      "anomaly": "none",
      "anomaly_magnitude": 50.0,
      "current_value": 24.5,
      "last_published": null
    }
  ]
}
