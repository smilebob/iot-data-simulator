ddle\" font-weight=\"bold\">ÉCHANGEUR</text>\n    <text x=\"640\" y=\"145\" fill=\"#64748B\" font-size=\"9\" text-anchor=\"middle\">Régulation PID</text>\n\n    <!-- Distribution Usine -->\n    <path d=\"M 700 150 L 820 150\" fill=\"none\" stroke=\"#059669\" stroke-width=\"6\" class=\"pipe-flow\"/>\n    <polygon points=\"820,145 835,150 820,155\" fill=\"#059669\"/>\n    <text x=\"780\" y=\"140\" fill=\"#059669\" font-size=\"10\" font-weight=\"bold\">DISTRIBUTION</text>\n\n    <!-- Callouts SCADA Light -->\n    \n    <g transform=\"translate(660, 25)\">\n      <rect width=\"230\" height=\"40\" rx=\"6\" fill=\"#F1F5F9\" stroke=\"#CBD5E1\" stroke-width=\"1.5\"/>\n      <rect width=\"4\" height=\"40\" rx=\"2\" fill=\"#0284C7\"/>\n      <text x=\"12\" y=\"15\" fill=\"#475569\" font-size=\"9\" font-weight=\"600\">Puissance Électrique Usine</text>\n      <text x=\"12\" y=\"32\" fill=\"#0F172A\" font-size=\"13\" font-weight=\"bold\" font-family=\"monospace\">${puissance_elec_kw:1}</text>\n    </g>\n    \n    <g transform=\"translate(660, 85)\">\n      <rect width=\"230\" height=\"40\" rx=\"6\" fill=\"#F1F5F9\" stroke=\"#CBD5E1\" stroke-width=\"1.5\"/>\n      <rect width=\"4\" height=\"40\" rx=\"2\" fill=\"#059669\"/>\n      <text x=\"12\" y=\"15\" fill=\"#475569\" font-size=\"9\" font-weight=\"600\">Débit Gaz Naturel</text>\n      <text x=\"12\" y=\"32\" fill=\"#0F172A\" font-size=\"13\" font-weight=\"bold\" font-family=\"monospace\">${debit_gaz_nm3h:1}</text>\n    </g>\n  </svg>\n    \n</div>\n",
