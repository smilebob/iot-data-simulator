              "html": "\n    <div style=\"background:#0F172A; border-radius:12px; padding:18px; color:#F8FAFC; font-family:sans-serif; position:relative; overflow:hidden; border:1px solid #1E293B;\">\n      <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; border-bottom:1px solid #334155; pb:8px;\">\n        <div style=\"font-size:14px; font-weight:700; color:#38BDF8; letter-spacing:0.5px;\">SYNOPTIQUE INDUSTRIEL SCADA</div>\n        <div style=\"font-size:11px; color:#94A3B8;\">Équipement : <strong style=\"color:#FFF;\">Ligne de Pasteurisation Flash HTST</strong></div>\n      </div>\n      <svg viewBox=\"0 0 720 380\" width=\"100%\" height=\"100%\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <style>\n            @keyframes pipeFlow {\n              0% { stroke-dashoffset: 40; }\n              100% { stroke-dashoffset: 0; }\n            }\n            .scada-flow {\n              stroke-dasharray: 8, 4;\n              animation: pipeFlow 1.2s linear infinite;\n            }\n          </style>\n          <linearGradient id=\"eqGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#1E293B\"/>\n            <stop offset=\"100%\" stop-color=\"#0F172A\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Tuyauteries de process avec animation de fluide -->\n        <path d=\"M 60 190 L 220 190 L 220 280 L 450 280 L 450 190 L 470 190\" fill=\"none\" stroke=\"#475569\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n        <path d=\"M 60 190 L 220 190 L 220 280 L 450 280 L 450 190 L 470 190\" fill=\"none\" stroke=\"#38BDF8\" stroke-width=\"3\" class=\"scada-flow\"/>\n\n        <!-- Bâtie Machine / Process Tank -->\n        <rect x=\"180\" y=\"90\" width=\"220\" height=\"200\" rx=\"14\" fill=\"url(#eqGrad)\" stroke=\"#0284C7\" stroke-width=\"2.5\"/>\n        <text x=\"290\" y=\"125\" fill=\"#38BDF8\" font-size=\"13\" font-weight=\"800\" text-anchor=\"middle\" letter-spacing=\"1\">UNITÉ DE PROCESS</text>\n        <circle cx=\"290\" cy=\"195\" r=\"45\" fill=\"#182234\" stroke=\"#0284C7\" stroke-width=\"1.5\"/>\n        <text x=\"290\" y=\"200\" fill=\"#94A3B8\" font-size=\"10\" font-family=\"monospace\" text-anchor=\"middle\">ACTIVE</text>\n\n        <!-- Étiquettes de mesures dynamiques ThingsBoard -->\n        \n        <g transform=\"translate(480, 120)\">\n          <rect width=\"180\" height=\"36\" rx=\"6\" fill=\"#0B132B\" stroke=\"#38BDF8\" stroke-width=\"1.2\"/>\n          <circle cx=\"16\" cy=\"18\" r=\"4\" fill=\"#38BDF8\"/>\n          <text x=\"28\" y=\"16\" fill=\"#94A3B8\" font-size=\"9\" font-family=\"sans-serif\">Débit Liquide Alimenta</text>\n          <text x=\"28\" y=\"29\" fill=\"#38BDF8\" font-size=\"12\" font-weight=\"bold\" font-family=\"monospace\">${debit_produit:1} m³/h</text>\n        </g>\n        \n\n        <g transform=\"translate(480, 164)\">\n          <rect width=\"180\" height=\"36\" rx=\"6\" fill=\"#0B132B\" stroke=\"#38BDF8\" stroke-width=\"1.2\"/>\n          <circle cx=\"16\" cy=\"18\" r=\"4\" fill=\"#38BDF8\"/>\n          <text x=\"28\" y=\"16\" fill=\"#94A3B8\" font-size=\"9\" font-family=\"sans-serif\">Température Entrée Pro</text>\n          <text x=\"28\" y=\"29\" fill=\"#38BDF8\" font-size=\"12\" font-weight=\"bold\" font-family=\"monospace\">${temp_entree:1} °C</text>\n        </g>\n        \n\n        <g transform=\"translate(480, 208)\">\n          <rect width=\"180\" height=\"36\" rx=\"6\" fill=\"#0B132B\" stroke=\"#38BDF8\" stroke-width=\"1.2\"/>\n          <circle cx=\"16\" cy=\"18\" r=\"4\" fill=\"#38BDF8\"/>\n          <text x=\"28\" y=\"16\" fill=\"#94A3B8\" font-size=\"9\" font-family=\"sans-serif\">Température Régénérati</text>\n          <text x=\"28\" y=\"29\" fill=\"#38BDF8\" font-size=\"12\" font-weight=\"bold\" font-family=\"monospace\">${temp_prechauffage:1} °C</text>\n        </g>\n        \n\n        <g transform=\"translate(480, 252)\">\n          <rect width=\"180\" height=\"36\" rx=\"6\" fill=\"#0B132B\" stroke=\"#38BDF8\" stroke-width=\"1.2\"/>\n          <circle cx=\"16\" cy=\"18\" r=\"4\" fill=\"#38BDF8\"/>\n          <text x=\"28\" y=\"16\" fill=\"#94A3B8\" font-size=\"9\" font-family=\"sans-serif\">Température Chambrage </text>\n          <text x=\"28\" y=\"29\" fill=\"#38BDF8\" font-size=\"12\" font-weight=\"bold\" font-family=\"monospace\">${temp_chambrage:1} °C</text>\n        </g>\n        \n\n        <g transform=\"translate(480, 296)\">\n          <rect width=\"180\" height=\"36\" rx=\"6\" fill=\"#0B132B\" stroke=\"#38BDF8\" stroke-width=\"1.2\"/>\n          <circle cx=\"16\" cy=\"18\" r=\"4\" fill=\"#38BDF8\"/>\n          <text x=\"28\" y=\"16\" fill=\"#94A3B8\" font-size=\"9\" font-family=\"sans-serif\">Température Sortie Con</text>\n          <text x=\"28\" y=\"29\" fill=\"#38BDF8\" font-size=\"12\" font-weight=\"bold\" font-family=\"monospace\">${temp_sortie:1} °C</text>\n        </g>\n        \n\n        <g transform=\"translate(480, 340)\">\n          <rect width=\"180\" height=\"36\" rx=\"6\" fill=\"#0B132B\" stroke=\"#38BDF8\" stroke-width=\"1.2\"/>\n          <circle cx=\"16\" cy=\"18\" r=\"4\" fill=\"#38BDF8\"/>\n          <text x=\"28\" y=\"16\" fill=\"#94A3B8\" font-size=\"9\" font-family=\"sans-serif\">Pression Côté Pasteuri</text>\n          <text x=\"28\" y=\"29\" fill=\"#38BDF8\" font-size=\"12\" font-weight=\"bold\" font-family=\"monospace\">${pression_pasteurise:1} bar</text>\n        </g>\n        \n      </svg>\n    </div>\n    ",
              "cardCss": "",
              "css": ""
            }
          }
        },
